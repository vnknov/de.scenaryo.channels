# Use a long random value and set the same variable on the OpenCode host.
CHANNELS_MCP_TOKEN=replace-with-a-long-random-token

# Include every hostname or IP clients use in the HTTP Host header.
CHANNELS_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.50

# Optional host-side published port for Docker Compose.
CHANNELS_PORT=3000

# Credentials referenced by the example channel configuration files.
WORK_SMTP_USER=agent@company.example
WORK_SMTP_PASS=replace-me
PRIVATE_SMTP_USER=agent@example.org
PRIVATE_SMTP_PASS=replace-me
